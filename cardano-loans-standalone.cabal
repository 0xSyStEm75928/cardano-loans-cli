cabal-version:      2.4
name:               cardano-loans-standalone
version:            1.0.0.0
synopsis:           Generic standalone Cardano loan CLI
description:
  A completely standalone, generic command-line application for Cardano loan requests.
  No proprietary architecture, no external runtime dependencies.
license:            Apache-2.0
author:             Cardano Community
maintainer:         community@cardano.org
copyright:          2026
category:           Finance
build-type:         Simple

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints

common lang
  default-language:  Haskell2010
  default-extensions:
    DeriveGeneric
    OverloadedStrings
    RecordWildCards

library
  import:           warnings, lang
  exposed-modules:
    CardanoLoans.Lib
    CardanoLoans.Config
    CardanoLoans.Types
    CardanoLoans.Commands.Build
    CardanoLoans.Commands.Sign
    CardanoLoans.Commands.Submit
    CardanoLoans.Commands.Status
  build-depends:
    base >=4.16 && <5,
    aeson >=1.5 && <2.3,
    bytestring >=0.10 && <0.13,
    text >=1.2 && <2.2,
    containers >=0.6 && <0.7,
    process >=1.6 && <1.7,
    filepath >=1.4 && <1.5,
    directory >=1.3 && <1.4,
    cryptohash-sha256 >=0.11 && <0.12,
    base16-bytestring >=0.1 && <1.1,
    time >=1.9 && <1.15,
    http-conduit >=2.3 && <2.4,
    http-types >=0.12 && <0.13,
    mtl >=2.2 && <2.4
  hs-source-dirs:   src

executable cardano-loans
  import:           warnings, lang
  main-is:          Main.hs
  other-modules:
    CLI.Parser
    CLI.Runner
  build-depends:
    base >=4.16 && <5,
    cardano-loans-standalone,
    optparse-applicative >=0.16 && <0.19,
    aeson >=1.5 && <2.3,
    aeson-pretty >=0.8 && <0.9,
    bytestring >=0.10 && <0.13,
    text >=1.2 && <2.2
  hs-source-dirs:   app
